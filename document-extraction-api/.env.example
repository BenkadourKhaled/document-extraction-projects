# ---------------------------------------------------------------------------
# Document Extraction API - example environment file.
# Copy to .env before running Docker Compose:
#   cp .env.example .env
# Then replace every "change-me" value. JWT_SECRET must be at least 32 bytes.
# ---------------------------------------------------------------------------

# PostgreSQL (production / Docker Compose)
POSTGRES_DB=document_extraction
POSTGRES_USER=document
POSTGRES_PASSWORD=change-me-database-password

# MinIO / S3-compatible object storage (production / Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=document-extraction

# First administrator. Created once when the database is empty.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ORG_NAME=Mon organisation
BOOTSTRAP_ORG_SLUG=default
BOOTSTRAP_ADMIN_EMAIL=admin@organisation.dz
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME=Administrateur

# Authentication
JWT_SECRET=change-me-with-at-least-32-random-bytes
JWT_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15

# HTTP / frontend
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:8081
FRONTEND_CONTEXT=../document-extraction-front-end
FRONTEND_PORT=8081

# Optional TLS proxy (docker compose --profile tls)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Optional Prometheus (docker compose --profile monitoring)
PROMETHEUS_PORT=9090

# File retention (0 disables automatic purge)
RETENTION_DAYS=30
RETENTION_PURGE_ENABLED=true

# Durable queue worker
QUEUE_WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_MS=1500
QUEUE_MAX_ATTEMPTS=3

# Extraction limits
MAX_FILE_SIZE_BYTES=52428800
MAX_PAGES=50
NATIVE_TEXT_MIN_CHARACTERS=30
PDF_DPI=300

# OCR
OCR_DEFAULT_LANGUAGES=fra+eng
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Optional local AI field extraction with Ollama.
# The model must already be pulled: ollama pull llama3.2:1b
# Docker Compose uses host.docker.internal to reach Ollama on the host.
# When running the API directly on the host, use http://localhost:11434.
# If Ollama runs on the host and the API runs in Docker, start Ollama with
# OLLAMA_HOST=0.0.0.0:11434 so the container can reach it.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_INPUT_CHARACTERS=12000
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m

# Storage for local runs outside Docker. Override with STORAGE_TYPE=s3 and
# MINIO_ENDPOINT=http://localhost:9000 when using MinIO from the host.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/storage
MINIO_ENDPOINT=http://localhost:9000

# Local H2 database (ignored when SPRING_PROFILES_ACTIVE=postgres)
# DATABASE_URL=jdbc:h2:file:./data/db/document-extraction;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE

# MinIO official images were removed from Docker Hub. Pin a trusted mirror by digest in production.
MINIO_IMAGE=elestio/minio:latest

# Host port for the API (use 18080 locally if 8080 is already taken).
API_PORT=8080
