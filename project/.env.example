# Base URL of the Spring Boot extraction API.
# The app prepends this to relative paths like /extractions.
# Use "/api/v1" both behind nginx (Docker) and in local dev: the Vite dev
# server proxies /api/v1 to http://localhost:18080 (see vite.config.ts).
# Override VITE_DEV_API_PROXY if your backend runs on another host/port.
VITE_API_URL=/api/v1
